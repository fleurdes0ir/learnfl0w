# Salin ke .env lalu isi nilainya. JANGAN commit .env.

# --- Umum ---
APP_ENV=local                    # local | staging | cloud
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Database (lokal; di cloud memakai Secret Manager) ---
POSTGRES_USER=learnfl0w
POSTGRES_PASSWORD=learnfl0w
POSTGRES_DB=learnfl0w
# Dipakai backend di luar Docker Compose:
DATABASE_URL=postgresql+psycopg://learnfl0w:learnfl0w@localhost:5432/learnfl0w

# --- Auth ---
JWT_SECRET=ganti-dengan-string-acak-minimal-32-byte
JWT_ACCESS_TTL_MINUTES=30
REFRESH_TTL_DAYS=7
ADMIN_EMAILS=admin@example.com   # dipisah koma; email ini mendapat peran admin
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Lapisan AI: Langflow (dipanggil oleh backend) ---
LLM_PROVIDER=router              # varian flow utama: router | vertex
LLM_FALLBACK_PROVIDER=vertex     # varian flow cadangan (circuit breaker)
LANGFLOW_VERSION=1.12.0          # dipin; verifikasi tag image sebelum dipakai
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_API_KEY=                # buat di UI Langflow: Settings > API keys
LANGFLOW_USE_ID_TOKEN=false      # true di cloud (Cloud Run IAM)
LANGFLOW_TIMEOUT_SECONDS=30
LANGFLOW_ROADMAP_TIMEOUT_SECONDS=60
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=60
INTERNAL_TOOL_TOKEN=ganti-token-internal-acak   # dipakai Langflow untuk memanggil /internal/tools/*
RUN_LIVE_LLM=0                   # 1 = evaluasi AI memakai LLM sungguhan (berbiaya)

# --- Layanan Langflow (dibaca oleh container Langflow, bukan backend) ---
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=ganti-password-kuat
LANGFLOW_SECRET_KEY=ganti-dengan-string-acak-tetap
ROUTER_BASE_URL=http://localhost:20128/v1   # 9router (via Tailscale)
ROUTER_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=asia-southeast2

# --- Embedding (dipanggil dari backend) ---
EMBEDDING_PROVIDER=vertex        # vertex | onnx
EMBEDDING_MODEL=                 # mis. model embedding multibahasa Vertex AI

# --- Seed (opsional; default ../data/seed) ---
# SEED_DIR=../data/seed

# --- Batas pemakaian ---
DAILY_SESSION_LIMIT=5
MAX_TURNS_PER_SESSION=25

# --- Frontend (dibaca saat build) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
